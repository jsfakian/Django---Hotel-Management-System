# HMS Hotel Management System - Production Environment Configuration
# Copy this file to .env.prod and update values for your production environment
# IMPORTANT: Never commit .env.prod to version control - use a secure secrets management system

# ============================================================================
# CRITICAL SECURITY SETTINGS - CHANGE THESE IMMEDIATELY
# ============================================================================

# Django Secret Key - Generate a new one for production
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_KEY_IN_PRODUCTION

# Debug must be False in production
DEBUG=False

# Allowed hosts for this deployment (comma-separated)
ALLOWED_HOSTS=centaur.med.uoc.gr

# CSRF trusted origins (must include https:// prefix)
CSRF_TRUSTED_ORIGINS=https://centaur.med.uoc.gr

# ============================================================================
# PostgreSQL Database (Production)
# ============================================================================

# Database connection details
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hms_production
DB_USER=hms_prod_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD_MINIMUM_20_CHARS

# Public port exposure (leave as-is if behind load balancer)
POSTGRES_HOST_PORT=5433

# Database optimization settings
POSTGRES_DB=hms_production
POSTGRES_USER=hms_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD_MINIMUM_20_CHARS

# ============================================================================
# Redis Cache & Celery Broker (Production)
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=  # Set to empty string or provide password if configured
REDIS_MAX_MEMORY=1gb  # Maximum memory for Redis
CACHE_URL=redis://redis:6379/2

# ============================================================================
# Celery Configuration (Production)
# ============================================================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False  # Must be False for async tasks in production
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# ============================================================================
# Django Admin User (Auto-created on first run)
# ============================================================================

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# ============================================================================
# Email Configuration (Production)
# ============================================================================

# Email backend - using SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com  # Or your email provider's SMTP host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com  # Your email address
EMAIL_HOST_PASSWORD=your-app-specific-password  # Use app-specific password, not your account password

# From address for outgoing emails
DEFAULT_FROM_EMAIL=noreply@nephele.gr
SERVER_EMAIL=errors@nephele.gr  # For system error emails

# ============================================================================
# Security Settings (Production)
# ============================================================================

# SSL/HTTPS Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000  # 1 year
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CORS Settings (for frontend domain)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# ============================================================================
# Payment Processing (Stripe)
# ============================================================================

STRIPE_PUBLIC_KEY=pk_live_your_public_key
STRIPE_SECRET_KEY=sk_live_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================================================
# MyData (AADE) Integration - Greek Tax Authority
# ============================================================================

MYDATA_API_BASE=https://www1.mydata.aade.gr/api  # Production API URL
MYDATA_USERNAME=your_aade_username
MYDATA_PASSWORD=your_aade_password
MYDATA_API_KEY=your_aade_api_key
MYDATA_TIMEOUT=30
MYDATA_AUTO_TRANSMISSION=True  # Auto-transmit invoices to tax authority
MYDATA_SANDBOX_MODE=False  # Use production API (not sandbox)
MYDATA_TRANSMISSION_RETRIES=3

# Hotel tax ID (AFM - Α.Φ.Μ.)
HOTEL_TAX_ID=123456789

# ============================================================================
# AWS S3 (Optional - for media storage)
# ============================================================================

# Use S3 for media files instead of local storage
USE_S3=False  # Set to True to enable S3 storage

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-west-1

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry Error Tracking (Optional - for error monitoring)
SENTRY_DSN=  # Leave empty or provide Sentry DSN for error tracking

# ============================================================================
# Monitoring & Analytics (Optional)
# ============================================================================

# Application Performance Monitoring (APM)
# Datadog, New Relic, or similar service credentials would go here

# Google Analytics (if needed)
GOOGLE_ANALYTICS_ID=

# ============================================================================
# Business Configuration
# ============================================================================

# Hotel name and details
HOTEL_NAME=Your Hotel Name
HOTEL_EMAIL=reservations@your-domain.com
HOTEL_PHONE=+30 2xxx xxx xxxx

# Support contact
SUPPORT_EMAIL=support@your-domain.com
SUPPORT_PHONE=+30 2xxx xxx xxxx

# ============================================================================
# Feature Flags (for gradual rollout)
# ============================================================================

FEATURE_DYNAMIC_PRICING=True
FEATURE_ANALYTICS=True
FEATURE_AUTOMATED_INVOICING=True
FEATURE_CHANNEL_INTEGRATION=True

# ============================================================================
# Performance Settings
# ============================================================================

# Page size for API pagination
REST_FRAMEWORK_PAGE_SIZE=50

# Cache timeout (in seconds)
CACHE_TIMEOUT=3600  # 1 hour

# Database connection pool size
DB_CONN_POOL_SIZE=10

# ============================================================================
# Backup Settings
# ============================================================================

# Backup destination (local path, S3, etc.)
BACKUP_DESTINATION=/backup

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# Auto backup schedule (cron format)
# Example: "0 2 * * *" = daily at 2 AM
BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# Maintenance Mode
# ============================================================================

MAINTENANCE_MODE=False
MAINTENANCE_MODE_MESSAGE=The system is under maintenance. We will be back soon.

# ============================================================================
# Additional Configuration
# ============================================================================

# Timezone
TIME_ZONE=UTC  # or Europe/Athens for Greek timezone

# Language
LANGUAGE_CODE=en-us  # or el for Greek

# Site ID for Django Sites framework
SITE_ID=1
