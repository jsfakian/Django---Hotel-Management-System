{
  "dashboard": {
    "title": "HMS - Celery Task Queue",
    "tags": ["hms", "celery", "tasks"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Task Completion Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(celery_task_total[5m])",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Task Success vs Failure",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(celery_task_succeeded_total[5m])",
            "refId": "A",
            "legendFormat": "Success"
          },
          {
            "expr": "rate(celery_task_failed_total[5m])",
            "refId": "B",
            "legendFormat": "Failed"
          }
        ]
      },
      {
        "id": 3,
        "title": "Queue Length by Queue",
        "type": "graph",
        "targets": [
          {
            "expr": "celery_queue_length",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Task Execution Time by Task",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(celery_task_runtime_seconds_bucket[5m])) by (task_name, le))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Worker Status",
        "type": "table",
        "targets": [
          {
            "expr": "celery_worker_up",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Task Retry Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(celery_task_retried_total[5m])",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Active Tasks",
        "type": "stat",
        "targets": [
          {
            "expr": "celery_active_tasks",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Task Failure Reasons",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum(rate(celery_task_failed_total[5m])) by (exception))",
            "refId": "A"
          }
        ]
      }
    ],
    "refresh": "30s",
    "schemaVersion": 37,
    "style": "dark",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "uid": "hms-celery-tasks",
    "version": 1
  }
}
