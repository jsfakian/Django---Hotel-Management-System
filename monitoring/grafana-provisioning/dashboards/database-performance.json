{
  "dashboard": {
    "title": "HMS - Database Performance",
    "tags": ["hms", "database", "postgres"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Transaction Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_database_xact_commit[5m])",
            "refId": "A",
            "legendFormat": "Commits"
          },
          {
            "expr": "rate(pg_stat_database_xact_rollback[5m])",
            "refId": "B",
            "legendFormat": "Rollbacks"
          }
        ]
      },
      {
        "id": 2,
        "title": "Connection Count",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_stat_activity_count",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Database Cache Hit Ratio",
        "type": "gauge",
        "targets": [
          {
            "expr": "rate(pg_stat_database_heap_blks_hit[5m]) / (rate(pg_stat_database_heap_blks_hit[5m]) + rate(pg_stat_database_heap_blks_read[5m]))",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Rows Inserted/Updated/Deleted",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_user_tables_n_tup_ins[5m])",
            "refId": "A",
            "legendFormat": "Inserts"
          },
          {
            "expr": "rate(pg_stat_user_tables_n_tup_upd[5m])",
            "refId": "B",
            "legendFormat": "Updates"
          },
          {
            "expr": "rate(pg_stat_user_tables_n_tup_del[5m])",
            "refId": "C",
            "legendFormat": "Deletes"
          }
        ]
      },
      {
        "id": 5,
        "title": "Database Size",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_database_size_bytes",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Sequential Scans vs Index Scans",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_user_tables_seq_scan[5m])",
            "refId": "A",
            "legendFormat": "Sequential"
          },
          {
            "expr": "rate(pg_stat_user_tables_idx_scan[5m])",
            "refId": "B",
            "legendFormat": "Index"
          }
        ]
      },
      {
        "id": 7,
        "title": "Long Running Queries",
        "type": "table",
        "targets": [
          {
            "expr": "pg_stat_activity_query_time_seconds > 30",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Lock Wait Time",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_database_blk_time[5m])",
            "refId": "A"
          }
        ]
      }
    ],
    "refresh": "30s",
    "schemaVersion": 37,
    "style": "dark",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "uid": "hms-database-performance",
    "version": 1
  }
}
