# Production Environment Configuration Template
# Copy this file to .env.prod and update with real production values
# NEVER commit .env.prod to version control!

# ==============================================================================
# Django Configuration (CRITICAL - Must Change)
# ==============================================================================

# Secret Key for cryptographic operations (Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=your-production-secret-key-here-change-this

# Debug mode (MUST be False in production)
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================

# PostgreSQL connection
POSTGRES_DB=hms_prod
POSTGRES_USER=hms_prod_user
POSTGRES_PASSWORD=your-strong-database-password-here
POSTGRES_HOST_PORT=5432
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_SHARED_BUFFERS=256MB

# Database Backup Configuration
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM UTC
DB_BACKUP_RETENTION_DAYS=30

# ==============================================================================
# Redis Configuration
# ==============================================================================

# Redis connection for Celery
REDIS_PORT=6379
REDIS_MAX_MEMORY=1gb
REDIS_EVICTION_POLICY=allkeys-lru

# ==============================================================================
# Celery Background Jobs
# ==============================================================================

# Celery configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ==============================================================================
# Security Configuration
# ==============================================================================

# SSL/TLS Configuration
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True

# CORS Configuration (for frontend domain)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CSRF trusted origins
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================================================
# Superuser Admin Account (Initial Setup)
# ==============================================================================

# WARNING: Change these immediately after first login!
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=change-me-immediately-in-production

# ==============================================================================
# Email Configuration (SMTP)
# ==============================================================================

# Email backend
SECRET_MANAGER_BACKEND=smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ==============================================================================
# Payment Gateway Configuration (Stripe)
# ==============================================================================

# Stripe API Keys (Get from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLIC_KEY=pk_live_your_public_key_here
STRIPE_SECRET_KEY=sk_live_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ==============================================================================
# Monitoring & Logging
# ==============================================================================

# Sentry Configuration (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.25

# Grafana Admin User
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-strong-grafana-password
GRAFANA_URL=https://grafana.yourdomain.com

# ==============================================================================
# External Integrations
# ==============================================================================

# Slack Notifications (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty Integration
PAGERDUTY_SERVICE_KEY=your-pagerduty-service-key

# Greek Tax Authority (myDATA/AADE)
AADE_USERNAME=your-aade-username
AADE_PASSWORD=your-aade-password
AADE_TEST_MODE=False

# ==============================================================================
# Application Features
# ==============================================================================

# Demo mode (disable in production)
DEMO_MODE=False

# Feature toggles
ENABLE_DYNAMIC_PRICING=True
ENABLE_ANALYTICS=True
ENABLE_TRAVEL_AGENT_MODULE=True
ENABLE_GDPR_EXPORT=True

# ==============================================================================
# Container Resource Limits (for Docker Compose)
# ==============================================================================

# Django container
DJANGO_CPU_LIMIT=2
DJANGO_MEMORY_LIMIT=2G
DJANGO_CPU_RESERVATION=1
DJANGO_MEMORY_RESERVATION=1G

# Celery worker
CELERY_CPU_LIMIT=2
CELERY_MEMORY_LIMIT=2G
CELERY_CPU_RESERVATION=1
CELERY_MEMORY_RESERVATION=1G

# PostgreSQL
POSTGRES_CPU_LIMIT=2
POSTGRES_MEMORY_LIMIT=2G
POSTGRES_CPU_RESERVATION=1
POSTGRES_MEMORY_RESERVATION=1G

# Redis
REDIS_CPU_LIMIT=1
REDIS_MEMORY_LIMIT=1G
REDIS_CPU_RESERVATION=0.5
REDIS_MEMORY_RESERVATION=512M

# ==============================================================================
# Backup & Recovery Configuration
# ==============================================================================

# Backup encryption
BACKUP_ENCRYPTION_ENABLED=True
BACKUP_ENCRYPTION_PASSWORD=your-backup-encryption-password

# Backup storage (S3/local)
BACKUP_STORAGE_TYPE=s3
BACKUP_S3_BUCKET=your-backup-bucket-name
BACKUP_S3_REGION=eu-west-1
BACKUP_S3_ACCESS_KEY=your-aws-access-key
BACKUP_S3_SECRET_KEY=your-aws-secret-key

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log levels
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO

# Log retention
LOG_RETENTION_DAYS=30
LOG_ROTATION_SIZE=100m

# ==============================================================================
# Performance Configuration
# ==============================================================================

# Cache configuration
CACHE_TIMEOUT_MINUTES=15
CACHE_MAX_ENTRIES=1000

# Connection pooling
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# ==============================================================================
# IMPORTANT SECURITY REMINDERS
# ==============================================================================
# 1. Generate a new SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 2. Use strong passwords (min 16 characters, with uppercase, lowercase, numbers, special chars)
# 3. Enable HTTPS/SSL (SECURE_SSL_REDIRECT=True)
# 4. Never commit this file to version control
# 5. Rotate secrets regularly
# 6. Use AWS Secrets Manager or similar for sensitive data
# 7. Enable 2FA on all accounts
# 8. Monitor logs for suspicious activity
# 9. Test backups monthly
# 10. Perform security audits quarterly

