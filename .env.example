# HMS Hotel Management System - Docker Environment Configuration
# Copy this file to .env and update values for your environment

# ============================================================================
# Django Configuration
# ============================================================================
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,django

# ============================================================================
# Database (PostgreSQL)
# ============================================================================
POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms_password
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432
POSTGRES_HOST_PORT=5433

# ============================================================================
# Redis (Cache & Celery Broker)
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_URL=redis://redis:6379/2

# ============================================================================
# Celery Configuration
# ============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=True

# ============================================================================
# Django Admin User (Auto-created on first run)
# ============================================================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# ============================================================================
# Email Configuration (Optional)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ============================================================================
# MyData (AADE) Integration (Greece)
# ============================================================================
MYDATA_SANDBOX_MODE=True
MYDATA_AUTO_TRANSMISSION=False
MYDATA_USERNAME=
MYDATA_PASSWORD=
MYDATA_API_KEY=
HOTEL_TAX_ID=

# ============================================================================
# Stripe Payment Integration (Optional)
# ============================================================================
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO